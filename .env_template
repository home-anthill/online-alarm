LOG_LEVEL=debug
ONLINE_REDIS_URI=redis://localhost:6379/0
NOTIFICATIONS_REDIS_URI=redis://localhost:6379/1
ALARMS_REDIS_URI=redis://localhost:6379/3
REDIS_USERNAME=redisuser
REDIS_PASSWORD=Password1!
CACHE_TIMEOUT_SECONDS=120
OFFLINE_TIMEOUT_SECONDS=60
# Path to the Firebase service account key JSON file (injected at runtime)
FCM_SERVICE_ACCOUNT_KEY_PATH=./serviceAccountKey.json